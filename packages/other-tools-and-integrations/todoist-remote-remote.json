{
  "type": "mcp-server",
  "name": "Todoist (remote)",
  "description": "Hosted Todoist server for managing tasks, projects and sections.",
  "packageName": "@alphesdk-remote/todoist-remote",
  "runtime": "node",
  "remotes": [
    {
      "type": "streamable-http",
