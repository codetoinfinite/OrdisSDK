{
  "type": "mcp-server",
  "name": "CrowdStrike Falcon",
  "description": "Detections, incidents, hosts, threat intel and vulnerabilities from CrowdStrike Falcon.",
  "packageName": "falcon-mcp",
  "packageVersion": "0.19.0",
  "runtime": "python",
  "readme": "https://github.com/CrowdStrike/falcon-mcp",
  "url": "https://github.com/CrowdStrike/falcon-mcp",
  "author": "CrowdStrike",
  "env": {
    "FALCON_CLIENT_ID": {
      "description": "Falcon API client ID",
      "required": true
    },
    "FALCON_CLIENT_SECRET": {
      "description": "Falcon API client secret",
      "required": true
    },
    "FALCON_BASE_URL": {
      "description": "API region URL",
      "required": false
    }
  }
}
