{
  "type": "mcp-server",
  "name": "Asana",
  "description": "Asana-hosted server for tasks, projects, goals and portfolios (legacy SSE at /sse).",
  "packageName": "@alphesdk-remote/asana",
  "runtime": "node",
  "remotes": [
    {
      "type": "streamable-http",
