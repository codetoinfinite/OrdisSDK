# AlpheSDK settings. Everything is optional; the values shown are the defaults.
# Copy this file to .env (or .env.local, which wins over .env) and uncomment what you need.
# Never commit files with real values: .env and .env.* are git-ignored, except this one.
# On Vercel, set these under Settings → Environment Variables instead.

# --- Server ---
# PORT=3003                          # or MCP_SERVER_PORT
# HOST=127.0.0.1                     # 0.0.0.0 listens on every interface; set ALPHE_SDK_API_KEYS first

# --- Access ---
# Keys that callers send as `Authorization: Bearer <key>` (or `x-api-key`) to run tools, use the
# MCP gateway at /mcp/*, chat with agents or manage the search index. Comma-separated, so a key
# can be rotated. Unset means open, which only development allows: `pnpm start` runs with
# NODE_ENV=production and refuses to start without keys of 32+ characters (openssl rand -hex 32).
# ALPHE_SDK_API_KEYS=
# In production, MCP servers run only in a sandbox. true also lets them run on this host (as the
# API's own user, so they can read its environment). Only for a host that holds nothing else.
# ALLOW_LOCAL_EXECUTION=false
# REGISTRY_BASE_URL=http://localhost:3003   # public URL, used for OAuth callbacks

# --- Sandboxes (where Node.js MCP servers run) ---
# MCP_SANDBOX_PROVIDER=LOCAL         # LOCAL, VERCEL, SANDOCK, E2B or DAYTONA
# VERCEL needs no key when deployed on Vercel. Locally, `vercel link` and `vercel env pull` add
# VERCEL_OIDC_TOKEN (valid 12 hours) to .env.local.
# SANDOCK_API_KEY=
# SANDOCK_API_URL=https://sandock.ai
# E2B_API_KEY=
# DAYTONA_API_KEY=
# DAYTONA_API_URL=

# --- Search ---
# ENABLE_SEARCH=false                # true uses Meilisearch; otherwise search runs in memory
# MEILI_HTTP_ADDR=http://localhost:7700
# MEILI_MASTER_KEY=

# --- Agent chat (OpenRouter) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- OAuth for remote servers without dynamic client registration ---
# MCP_OAUTH_CLIENT_ID=mcp-registry
# MCP_OAUTH_CLIENT_SECRET=

# --- Telemetry (PostHog logs) ---
# `pnpm dev`, and any run with DEBUG set, stops at startup unless both are set.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=
# DEBUG=
