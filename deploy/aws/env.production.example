# Copy to .env.production in the repo root (git-ignored), fill in, then: deploy/aws/deploy.sh secrets
# Each line becomes a SecureString at /alphesdk/<KEY> in SSM Parameter Store. The ECS task reads
# exactly these two; everything else (NODE_ENV, HOST, PORT, MCP_SANDBOX_PROVIDER=SANDOCK,
# ENABLE_SEARCH=false, REGISTRY_BASE_URL) is set in cloudformation.yml.

# Comma-separated, 32+ characters each (openssl rand -hex 32). Give one to the alphe chatbot as
# ALPHESDK_API_KEY.
ALPHE_SDK_API_KEYS=
# MCP servers run in Sandock sandboxes, never on the Fargate task.
SANDOCK_API_KEY=
